# =============================================================
# 店铺管理系统 · Docker 部署环境变量模板
# 用法：cp .env.example.docker .env 后填入真实值
# 注意：.env 已在 .gitignore / .dockerignore 中排除，不会进入仓库和镜像
# =============================================================

# ===== 平台凭证（飞书/豆包 aPaaS，FORCE_AUTHN_INNERAPI_DOMAIN 必填）=====
# 平台基础域名，缺失将导致服务启动失败
FORCE_AUTHN_INNERAPI_DOMAIN=https://your-platform-domain.example.com
# 以下按平台下发情况填写，如无则留空
FORCE_AUTHN_ACCESS_KEY=
FORCE_AUTHN_ACCESS_SECRET=
FORCE_AUTHN_TOKEN=
MIAODA_AUTHN_CODE=
MIAODA_DEV_INNER_DOMAIN_WITH_PREFIX=

# ===== 日志 =====
LOG_REQUEST_BODY=true
LOG_RESPONSE_BODY=true